# Copy to .env and fill in only if you want to override defaults.
# The project runs entirely on free sources; no API keys are required.

# Optional: custom browser User-Agent for polite, identified requests to
# public RBA/ABS/ASIC endpoints (they may rate-limit unauthenticated traffic).
ASX_QUANT_USER_AGENT="asx-quant-research/0.1 (educational project; contact: local)"

# Optional: base directories (default to <repo>/data)
# ASX_QUANT_DATA_ROOT=C:/Users/henry/projects/asx-quant-ml/data

# Optional: DuckDB database filename (default: <data_root>/warehouse.duckdb)
# ASX_QUANT_DUCKDB_PATH=
